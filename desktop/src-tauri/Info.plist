<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tauri merges this file into the generated macOS Info.plist at build time.

  NSMicrophoneUsageDescription is REQUIRED for cpal to access the mic — macOS
  denies (or never prompts) without it. System-output capture goes through
  ScreenCaptureKit, which is gated by the "Screen Recording" privacy permission;
  macOS prompts for that automatically the first time SCShareableContent is read
  (System Settings → Privacy & Security → Screen Recording), so there is no
  Info.plist key for it.
-->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Jarvis records meeting audio to transcribe and summarize it for you.</string>
</dict>
</plist>
