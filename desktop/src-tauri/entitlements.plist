<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for hardened-runtime / notarized builds. Not strictly required for
  an unsigned local `tauri dev` run (TCC still prompts), but needed once the app
  is signed for distribution so mic access isn't killed by the hardened runtime.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
