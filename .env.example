# Copy to .env.local and fill in. Never commit .env.local (.gitignore covers .env*).

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required even for local `next dev` — without it every DB-backed page 404s.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Owner --------------------------------------------------------------------
# v1 is single-user: every row is owned by this id.
OWNER_ID=

# The owner's IANA timezone — the single source of truth for every date/time
# computation in the app (lib/auth/currentUser.ts getOwnerTz).
#
# OWNER_TZ is server-only. NEXT_PUBLIC_OWNER_TZ is inlined into the client
# bundle AT BUILD TIME, so it must also be set in the Vercel project before a
# deploy — setting only the server var makes the browser and server disagree.
# Set both to the same value.
OWNER_TZ=Asia/Hong_Kong
NEXT_PUBLIC_OWNER_TZ=Asia/Hong_Kong

# --- Models -------------------------------------------------------------------
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# --- Telegram (optional) ------------------------------------------------------
# Set both to enable the webhook + proactive agent-completion pings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
